<?xml version="1.0"  ?><!DOCTYPE pmc-articleset PUBLIC "-//NLM//DTD ARTICLE SET 2.0//EN" "https://dtd.nlm.nih.gov/ncbi/pmc/articleset/nlm-articleset-2.0.dtd"><pmc-articleset><article xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:ali="http://www.niso.org/schemas/ali/1.0/" article-type="research-article" xml:lang="en" dtd-version="1.4"><front><journal-meta><journal-id journal-id-type="nlm-ta">Am J Case Rep</journal-id><journal-id journal-id-type="iso-abbrev">Am J Case Rep</journal-id><journal-id journal-id-type="pmc-domain-id">2001</journal-id><journal-id journal-id-type="pmc-domain">amjcasereps</journal-id><journal-id journal-id-type="publisher-id">amjcaserep</journal-id><journal-title-group><journal-title>The American Journal of Case Reports</journal-title></journal-title-group><issn pub-type="epub">1941-5923</issn><publisher><publisher-name>International Scientific Information, Inc.</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmcid">PMC6287448</article-id><article-id pub-id-type="pmcid-ver">PMC6287448.1</article-id><article-id pub-id-type="pmcaid">6287448</article-id><article-id pub-id-type="pmcaiid">6287448</article-id><article-id pub-id-type="pmid">30510152</article-id><article-id pub-id-type="doi">10.12659/AJCR.911840</article-id><article-id pub-id-type="publisher-id">911840</article-id><article-version article-version-type="pmc-version">1</article-version><article-categories><subj-group subj-group-type="heading"><subject>Articles</subject></subj-group></article-categories><title-group><article-title>A Spontaneous Regression of an Isolated Lymph Node Metastasis from a Primary Unknown Merkel Cell Carcinoma in a Patient with an Idiopathic Hyper-Eosinophilic Syndrome</article-title></title-group><contrib-group><contrib contrib-type="author"><name name-style="western"><surname>Longo</surname><given-names initials="R">Raffaele</given-names></name><xref ref-type="author-notes" rid="fn1-amjcaserep-19-1437"><sup>A</sup></xref><xref ref-type="author-notes" rid="fn2-amjcaserep-19-1437"><sup>B</sup></xref><xref ref-type="author-notes" rid="fn3-amjcaserep-19-1437"><sup>C</sup></xref><xref ref-type="author-notes" rid="fn4-amjcaserep-19-1437"><sup>D</sup></xref><xref ref-type="author-notes" rid="fn5-amjcaserep-19-1437"><sup>E</sup></xref><xref ref-type="author-notes" rid="fn6-amjcaserep-19-1437"><sup>F</sup></xref><xref ref-type="aff" rid="af1-amjcaserep-19-1437"><sup>1</sup></xref><xref ref-type="corresp" rid="c1-amjcaserep-19-1437"/></contrib><contrib contrib-type="author"><name name-style="western"><surname>Balasanu</surname><given-names initials="O">Oana</given-names></name><xref ref-type="author-notes" rid="fn1-amjcaserep-19-1437"><sup>A</sup></xref><xref ref-type="author-notes" rid="fn2-amjcaserep-19-1437"><sup>B</sup></xref><xref ref-type="author-notes" rid="fn3-amjcaserep-19-1437"><sup>C</sup></xref><xref ref-type="author-notes" rid="fn5-amjcaserep-19-1437"><sup>E</sup></xref><xref ref-type="aff" rid="af2-amjcaserep-19-1437"><sup>2</sup></xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>de Castaing</surname><given-names initials="MC">Mathilde Chastenet</given-names></name><xref ref-type="author-notes" rid="fn1-amjcaserep-19-1437"><sup>A</sup></xref><xref ref-type="author-notes" rid="fn2-amjcaserep-19-1437"><sup>B</sup></xref><xref ref-type="author-notes" rid="fn3-amjcaserep-19-1437"><sup>C</sup></xref><xref ref-type="author-notes" rid="fn4-amjcaserep-19-1437"><sup>D</sup></xref><xref ref-type="author-notes" rid="fn5-amjcaserep-19-1437"><sup>E</sup></xref><xref ref-type="author-notes" rid="fn6-amjcaserep-19-1437"><sup>F</sup></xref><xref ref-type="aff" rid="af1-amjcaserep-19-1437"><sup>1</sup></xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Chatelain</surname><given-names initials="E">Eric</given-names></name><xref ref-type="author-notes" rid="fn1-amjcaserep-19-1437"><sup>A</sup></xref><xref ref-type="author-notes" rid